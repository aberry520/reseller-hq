# Reseller HQ — copy to .env and fill in your own values. Never commit .env.
# URL of the background-remover service (backend/ in this repo).
# Run it on your laptop on the same Wi-Fi as your phone, e.g.:
#   BG_REMOVER_URL=http://192.168.1.50:8000
# Leave blank to skip background removal — the app keeps the original photo
# and shows a note on the item screen.
BG_REMOVER_URL=

# eBay is NOT connected in v1. When it is, credentials go here (never in git).
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
