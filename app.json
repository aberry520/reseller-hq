{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1833",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.austinberry.resellerhq",
      "predictiveBackGestureEnabled": false
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.austinberry.resellerhq",
      "supportsTablet": true
    },
    "name": "Reseller HQ",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Reseller HQ to scan QR codes on your inventory labels.",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Reseller HQ to access your photos so you can add product photos to listings."
        }
      ],
      "expo-sharing",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "reseller",
    "slug": "reseller-hq",
    "splash": {
      "backgroundColor": "#081025",
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "light",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
